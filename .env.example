# Production Environment Variables for Placement Interview Experience Portal
# When deploying to Render, Railway, or VPS, set these environment variables in your cloud dashboard.

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (replace <username>, <password>, and <cluster-url>)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/placement_portal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_placement_portal_production_2026
JWT_EXPIRE=7d

# CORS & Cookies
COOKIE_SECURE=true
CLIENT_URL=https://your-app-name.onrender.com

# Initial Administrator Credentials
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminPass@2026
ADMIN_NAME=Placement Cell Administrator
